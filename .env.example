# Names only. This library does not read secrets at runtime.
# Copy to .env if your scan worker later uses a named demo dir.
# Never commit .env.
#
# Pair with a single-flight sidecar (Curiosity-Docker or your own lock):
# the client wait must be longer than the worker scan cap.
# USERNAME_DISCOVERY_SCAN_TIMEOUT=60
# USERNAME_DISCOVERY_TIMEOUT=120
#
# Optional demo dir for *your* worker, not this kernel:
# AGENT_HOME=/tmp/sidecar-occupancy-demo
